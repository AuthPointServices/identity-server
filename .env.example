# Keycloak de desarrollo. No es el de :8080 que comparten letgrid y Orange: este va en :8180.
KC_PORT=8180
KC_MANAGEMENT_PORT=9180

# Base propia en el Postgres local; scripts/db.sh la crea con PG_ADMIN_DSN.
PG_ADMIN_DSN=postgres://postgres@127.0.0.1:5432/postgres?sslmode=disable
KC_DB_URL=jdbc:postgresql://127.0.0.1:5432/identity
KC_DB_USERNAME=identity
KC_DB_PASSWORD=identity_dev

# Se crean en el primer arranque, en el realm master. La cuenta de servicio es con la que keycloak-config-cli
# aplica config/; el usuario sirve para entrar a la consola mientras no haya una administración propia.
KC_BOOTSTRAP_ADMIN_CLIENT_ID=config-cli
KC_BOOTSTRAP_ADMIN_CLIENT_SECRET=dev-config-cli-secret
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# scripts/apply.sh aplica config/ contra este Keycloak.
KC_URL=http://localhost:8180

# Valores de config/.
REALM=fretchcop
BRAND_NAME=Fretchcop
# El dominio de las passkeys: localhost en desarrollo, fretchcop.space en producción.
PASSKEY_RP_ID=localhost

# Correo saliente. En desarrollo, Mailpit (scripts/mail.sh), sin usuario ni TLS; en producción, el SMTP real.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@fretchcop.space
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_AUTH=false
MAILPIT_UI=http://127.0.0.1:8025

# La Cuenta: dónde la ve el navegador (redirecciones) y dónde Keycloak avisa del cierre de sesión.
ACCOUNTS_URL=http://localhost:5180
ACCOUNTS_BACKCHANNEL_URL=http://localhost:8190/auth/backchannel-logout
ACCOUNTS_CLIENT_SECRET=dev-accounts-secret
